# Clé API Anthropic (facultative).
# Sans clé, l'application tourne en mode fallback : sélection catalogue sans IA,
# pas de synthèse rédigée. Tout le reste fonctionne.
ANTHROPIC_API_KEY=

# Modèle utilisé par le proxy (facultatif — valeur par défaut ci-dessous).
ANTHROPIC_MODEL=claude-sonnet-4-5

# Port du proxy backend (facultatif).
PORT=8787
